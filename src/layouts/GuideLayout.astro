---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BaseHead from '../components/seo/BaseHead.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import '../styles/global.css';
import { buildTitle, buildCanonical, SITE_NAME, SITE_URL, OG_IMAGE, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT, breadcrumbSchema, articleSchema, faqSchema, organizationSchema, personSchema, LAST_UPDATED } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  slug: string;
  /** §7 : trois à cinq questions propres au guide, affichées et balisées. */
  faqs?: { question: string; answer: string }[];
}

const { title, description, slug, faqs = [] } = Astro.props;
const pageTitle = buildTitle(title);
const canonical = buildCanonical(slug);
const isGuide = slug.startsWith('/guides/');

const breadcrumbItems = [
  { name: 'Home', url: SITE_URL },
  ...(isGuide ? [{ name: 'Guides', url: `${SITE_URL}/guides/` }] : []),
  { name: title, url: canonical },
];

const schemas: object[] = [
  breadcrumbSchema(breadcrumbItems),
  organizationSchema(),
  personSchema(),
];

if (isGuide) {
  schemas.push(articleSchema({ headline: title, description, url: canonical }));
}

if (faqs.length > 0) {
  schemas.push(faqSchema(faqs));
}
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Radif Partners" />
  <BaseHead slug={slug} pageType={isGuide ? 'guide' : 'page'} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
  <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
  <meta property="og:image:alt" content={`${title} - UK Tax Guide`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={OG_IMAGE} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="alternate" hreflang="en-GB" href={canonical} />
  <!-- Preload Inter font (self-hosted) -->
  <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Manifest -->
  <link rel="manifest" href="/manifest.webmanifest" />
  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

</head>
<body class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
  <a href="#main-content" class="skip-link bg-navy-600 text-white">Skip to content</a>
  <Header />

  <main id="main-content" class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs items={breadcrumbItems} />
    <article class="prose prose-gray dark:prose-invert max-w-none">
      <slot />
    </article>

    {faqs.length > 0 && (
      <section class="mt-10">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Frequently asked questions</h2>
        <div class="divide-y divide-gray-200 dark:divide-gray-700 rounded-lg border border-gray-200 dark:border-gray-700">
          {faqs.map((faq) => (
            <details class="group p-4">
              <summary class="cursor-pointer font-medium text-gray-900 dark:text-white">{faq.question}</summary>
              <p class="mt-2 leading-relaxed text-gray-600 dark:text-gray-300">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {isGuide && (
      <div class="mt-10 flex items-center gap-4 rounded-lg border border-gray-200 dark:border-gray-700 px-5 py-4">
        <div class="text-sm">
          <p class="font-semibold text-gray-900 dark:text-white">Written by <a href="/about/" class="text-navy-600 hover:underline dark:text-navy-400">Radif Partners</a></p>
          <p class="text-gray-500 dark:text-gray-400">Publisher of UK salary calculators and practical tax guides</p>
        </div>
      </div>
    )}

    <p class="mt-8 text-sm text-gray-400 dark:text-gray-500">{LAST_UPDATED}</p>
  </main>

  <Footer />
</body>
</html>
