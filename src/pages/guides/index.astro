---
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import '../../styles/global.css';
import { buildCanonical, SITE_NAME, SITE_URL, OG_IMAGE, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT, breadcrumbSchema, faqSchema, organizationSchema, personSchema, LAST_UPDATED } from '../../lib/seo';

const title = 'UK Tax & Salary Guides 2026/27: PAYE, Income Tax & More';
const description = 'Free guides to UK income tax, National Insurance, PAYE, student loans, pensions and the 2026/27 tax year. Plain English explanations with worked examples.';
const canonical = buildCanonical('/guides/');

const breadcrumbItems = [
  { name: 'Home', url: SITE_URL },
  { name: 'Guides', url: canonical },
];

const faqs = [
  { question: "Which guide should I read first?", answer: "If you have just started a job, the PAYE guide and the tax year guide between them explain the first payslip. If you are checking a deduction, the National Insurance and income tax band guides answer most questions. If you are trying to keep more of your pay, start with salary sacrifice." },
  { question: "Are these guides UK-wide?", answer: "They cover the whole UK and flag where Scotland differs, which is on income tax rates and bands only. National Insurance, student loan repayment and pension rules are identical across the four nations. Where a rule differs in Scotland, the guide says so in the paragraph concerned rather than in a footnote, because the difference changes the arithmetic rather than the principle." },
  { question: "How often are they updated?", answer: "At the start of each tax year, when the new rates and thresholds are published, and at any point when a rule changes mid-year. Each guide carries the date of its last check rather than the date it was served." },
  { question: "Who writes them?", answer: "Radif Partners, which publishes this site. The figures come from HMRC and the Scottish Government, each guide names the source of any rate it quotes, and none of it is a substitute for advice from an accountant who knows your circumstances." },
  { question: "Do these guides replace an accountant?", answer: "No. They explain the rules that apply to everyone and the figures behind them, which is enough to check a payslip or a tax code. A return with rental income, share options or a business in it needs someone who can see the whole picture." },
  { question: "Can I use the figures in these guides for my tax return?", answer: "As a check, yes. The rates and thresholds quoted are the published ones, so a guide is a good way to see whether a number looks plausible. The return itself depends on documents only you hold, and on choices such as filing status that a guide cannot make for you." },
];

const schemas = [
  faqSchema(faqs),
  breadcrumbSchema(breadcrumbItems),
  organizationSchema(),
  personSchema(),
];

const guides = [
  {
    href: '/guides/uk-tax-year-2026-27/',
    title: 'UK Tax Year 2026/27: Complete Guide',
    desc: 'All income tax bands, NI rates, student loan thresholds and pension limits for the current tax year.',
    category: 'Tax Year',
  },
  {
    href: '/guides/how-paye-works/',
    title: 'How PAYE Works in the UK',
    desc: 'How employers calculate and deduct income tax and NI from your pay, including tax codes and cumulative vs Week 1 basis.',
    category: 'Payroll',
  },
  {
    href: '/guides/income-tax-bands-explained/',
    title: 'Income Tax Bands Explained',
    desc: 'A breakdown of UK income tax rates for England, Wales, Northern Ireland and Scotland, with worked examples.',
    category: 'Income Tax',
  },
  {
    href: '/guides/national-insurance-explained/',
    title: 'National Insurance Explained',
    desc: 'Employee and employer NI rates, thresholds, classes and how contributions affect your State Pension.',
    category: 'National Insurance',
  },
  {
    href: '/guides/student-loan-repayment-guide/',
    title: 'Student Loan Repayment Guide',
    desc: 'Repayment thresholds and rates for Plan 1, 2, 4, 5 and postgraduate loans, plus how they interact with PAYE.',
    category: 'Student Loans',
  },
  {
    href: '/guides/pension-salary-sacrifice-explained/',
    title: 'Pension & Salary Sacrifice Explained',
    desc: 'How workplace pensions work, auto-enrolment minimums, and the tax advantages of salary sacrifice vs relief at source.',
    category: 'Pensions',
  },
];
const resumeCitable = "These guides cover the UK pay and tax system in the order most people meet it: how a payslip is built and why the net figure is so much lower than the salary, how to read and correct a tax code, what the income tax bands actually do, how National Insurance differs from income tax, and how student loans and pension contributions change the picture. Each rate quoted comes from the published HMRC figures or, for Scotland, from the Scottish Government, and every page carries the date of its last genuine check rather than the date it was served. Where a rule differs in Scotland, the guide says so in the paragraph concerned, because the difference changes the arithmetic rather than the principle. None of it substitutes for an accountant who can see your whole position, particularly where rental income or share options are involved.";

const corpsRedige = [{"titre": "Where to start, depending on your question", "paragraphes": ["If you have just started a job and the first payslip looks wrong, read the PAYE guide and then check your tax code: between them they explain nine out of ten surprises. If you are trying to work out why a pay rise left less in hand than expected, the income tax bands guide covers the marginal rate and the two thresholds where the effect is sharpest.", "If you are weighing up a pension contribution, the salary sacrifice guide is the one that matters, because the choice of mechanism changes the saving by a third. And if you are self-employed or about to be, start with the National Insurance guide, which explains why the contribution classes differ and what each one buys."]}];

---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Radif Partners" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
  <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
  <meta property="og:image:alt" content="UK Tax and Salary Guides - PAYE, income tax and more" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={OG_IMAGE} />
  <BaseHead slug="/guides/" pageType="hub" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="manifest" href="/manifest.webmanifest" />
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
  <a href="#main-content" class="skip-link bg-navy-600 text-white">Skip to content</a>
  <Header />

  <main id="main-content" class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs items={breadcrumbItems} />
    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">Guides</h1>
      <p class="mt-3 text-lg text-gray-500 dark:text-gray-400">
        Plain English guides to UK taxes, payroll and personal finance, with worked examples and links to our free calculators.
      </p>
    </header>
    <p class="mt-6 rounded-lg border-l-4 border-navy-600 bg-gray-50 p-4 text-base leading-relaxed text-gray-800 dark:border-navy-400 dark:bg-gray-800/40 dark:text-gray-200">
      {resumeCitable}
    </p>

    <div class="grid gap-4 sm:grid-cols-2">
      {guides.map((guide) => (
        <a href={guide.href} class="group rounded-lg border border-gray-200 p-5 transition-colors hover:border-navy-300 hover:bg-navy-50 dark:border-gray-700 dark:hover:border-navy-600 dark:hover:bg-gray-800">
          <span class="text-xs font-medium uppercase tracking-wider text-navy-600 dark:text-navy-400">{guide.category}</span>
          <h2 class="mt-1 font-semibold text-gray-900 group-hover:text-navy-700 dark:text-white dark:group-hover:text-navy-300">{guide.title}</h2>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">{guide.desc}</p>
        </a>
      ))}
    </div>

    <p class="mt-8 text-sm text-gray-400 dark:text-gray-500">{LAST_UPDATED}</p>
    <section class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Frequently asked questions</h2>
      <div class="divide-y divide-gray-200 dark:divide-gray-700 rounded-lg border border-gray-200 dark:border-gray-700">
        {faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer font-medium text-gray-900 dark:text-white">{faq.question}</summary>
            <p class="mt-2 leading-relaxed text-gray-600 dark:text-gray-300">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>


    <section class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Sources</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
        Every rate and threshold used on this site comes from the following official publications:
      </p>
      <ul class="space-y-1 text-sm">
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/guidance/rates-and-thresholds-for-employers-2026-to-2027" rel="noopener">HMRC, rates and thresholds for employers 2026/27</a></li>
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/income-tax-rates" rel="noopener">GOV.UK, income tax rates and personal allowances</a></li>
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/national-insurance-rates-letters" rel="noopener">GOV.UK, National Insurance rates and categories</a></li>
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/repaying-your-student-loan/what-you-pay" rel="noopener">GOV.UK, student loan repayment thresholds</a></li>
      </ul>
    </section>

    <section class="mt-12 space-y-8">
      {corpsRedige.map((bloc) => (
        <div>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">{bloc.titre}</h2>
          {bloc.paragraphes.map((p) => (
            <p class="mb-4 leading-relaxed text-gray-700 dark:text-gray-300">{p}</p>
          ))}
        </div>
      ))}
    </section>

  </main>

  <Footer />
</body>
</html>
