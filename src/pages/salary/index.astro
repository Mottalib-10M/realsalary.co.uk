---
/**
 * Hub page listing all monthly salary landing pages.
 * Groups salaries by range for easy browsing and internal linking.
 */
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import '../../styles/global.css';
import { generateMonthlySalaryPages } from '../../data/monthly-salary-pages';
import {
  buildTitle,
  buildCanonical,
  SITE_NAME,
  SITE_URL,
  OG_IMAGE,
  OG_IMAGE_WIDTH,
  OG_IMAGE_HEIGHT,
  breadcrumbSchema,
  faqSchema,
  organizationSchema,
  personSchema,
  LAST_UPDATED,
} from '../../lib/seo';
import { TAX_YEAR } from '../../data/tax-rules-2026-27';

const pages = generateMonthlySalaryPages();

const pageTitle = `Monthly Salary After Tax UK ${TAX_YEAR} - Take Home Pay`;
const metaTitle = buildTitle(pageTitle);
const description = `See what any monthly salary from £100 to £3,000 is worth after tax in the UK. Income tax, National Insurance and take home pay for the ${TAX_YEAR} tax year.`;
const canonical = buildCanonical('/salary/');

const breadcrumbItems = [
  { name: 'Home', url: SITE_URL },
  { name: 'Salary Pages', url: canonical },
];

const faqs = [
  { question: "How are these salary pages calculated?", answer: "Each one applies the 2026/27 income tax bands, National Insurance thresholds and the standard tax code to the salary in its title, then shows the monthly, weekly and hourly equivalents. The same engine drives the calculators, so the figures agree across the site." },
  { question: "Do the pages account for Scotland?", answer: "Yes. Every salary page shows the England, Wales and Northern Ireland figure alongside the Scottish one, because the six Scottish bands produce a different take-home at almost every salary above the personal allowance. National Insurance is identical across the UK, so only the tax line moves." },
  { question: "Do they include student loan or pension deductions?", answer: "No, they show the baseline: income tax and National Insurance on the standard tax code. A student loan repayment or a pension contribution lowers the figure, and the dedicated calculators let you add both to see the effect. A five per cent pension contribution typically changes the monthly figure by more than the whole Scottish divergence does." },
  { question: "Which salary page should I look at?", answer: "The one matching your gross annual or monthly salary. If your figure sits between two pages, the calculator gives the exact answer, and the two neighbouring pages bracket it closely enough for a quick sanity check. Salaries are listed by annual figure and by monthly figure, so either entry point works." },
  { question: "Why does my payslip show a different amount?", answer: "Usually a non-standard tax code, a student loan plan, a pension contribution taken after tax, or a benefit in kind such as a company car. Comparing the taxable pay line on the payslip with the gross used here finds the difference quickly." },
  { question: "How often are these figures updated?", answer: "At the start of each tax year, when the new bands and thresholds take effect, and whenever a threshold changes mid-year. Each page carries the date of its last check rather than the date it was served. A frozen threshold still counts as a check: the figure is verified even when it has not moved." },
];

const schemas = [
  faqSchema(faqs),
  breadcrumbSchema(breadcrumbItems),
  organizationSchema(),
  personSchema(),
];

// Group pages by salary range
const groups = [
  { label: '£100 – £500', pages: pages.filter((p) => p.monthly >= 100 && p.monthly <= 500) },
  { label: '£550 – £1,000', pages: pages.filter((p) => p.monthly >= 550 && p.monthly <= 1000) },
  { label: '£1,050 – £2,000', pages: pages.filter((p) => p.monthly >= 1050 && p.monthly <= 2000) },
  { label: '£2,050 – £3,000', pages: pages.filter((p) => p.monthly >= 2050 && p.monthly <= 3000) },
];

---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{metaTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Radif Partners" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
  <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
  <meta property="og:image:alt" content="UK monthly salary after tax - take home pay for £100–£3,000/month" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={OG_IMAGE} />
  <BaseHead slug="/salary/" pageType="hub" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="manifest" href="/manifest.webmanifest" />
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
  <a href="#main-content" class="skip-link bg-navy-600 text-white">Skip to content</a>
  <Header />

  <main id="main-content" class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs items={breadcrumbItems} />
    <div class="prose prose-gray dark:prose-invert max-w-none">
      <h1>Monthly Salary After Tax</h1>
      <p>
        Browse our complete guide to take-home pay in the UK for monthly salaries from £100 to £3,000.
        Each page shows a detailed breakdown of income tax, National Insurance,
        net pay, Scotland comparisons, and practical tips for the
        <strong>{TAX_YEAR} tax year</strong>. Click any salary to see the full analysis.
      </p>
    </div>

    {groups.map((group) => (
      <section class="mt-10">
        <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">{group.label} Per Month</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          {group.pages.map((p) => (
            <a
              href={`/salary/${p.slug}/`}
              class="group rounded-lg border border-gray-200 p-4 transition-all hover:border-navy-300 hover:shadow-md dark:border-gray-700 dark:hover:border-navy-600"
            >
              <div class="text-lg font-bold text-navy-700 group-hover:text-navy-600 dark:text-navy-300 dark:group-hover:text-navy-200">
                {p.monthlyFormatted}<span class="text-sm font-normal text-gray-400">/mo</span>
              </div>
              <div class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                Take-home: <span class="font-medium text-gray-700 dark:text-gray-200">{p.englandFormatted.netMonthly}</span>
              </div>
              <div class="mt-0.5 text-xs text-gray-400 dark:text-gray-500">
                {p.annualFormatted}/year &middot; {p.englandFormatted.effectiveTaxRate} tax rate
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div class="prose prose-gray dark:prose-invert mt-12 max-w-none">
      <h2>How These Figures Are Calculated</h2>
      <p>
        Every figure on these monthly salary pages is calculated using official HMRC rates for the {TAX_YEAR} tax year
        (6 April 2026 to 5 April 2027). We assume the standard tax code 1257L, no student loans, and no
        pension deductions. The calculations include both income tax and employee National Insurance
        contributions. Use our <a href="/">full salary calculator</a> to add student loans, pension
        contributions, Scottish tax rates, and other options.
      </p>
    </div>

    <div class="mt-8 flex items-center gap-4 rounded-lg border border-gray-200 dark:border-gray-700 px-5 py-4">
      <div class="text-sm">
        <p class="font-semibold text-gray-900 dark:text-white">Written by <a href="/about/" class="text-navy-600 hover:underline dark:text-navy-400">Radif Partners</a></p>
        <p class="text-gray-500 dark:text-gray-400">Publisher of UK salary calculators and practical tax guides</p>
      </div>
    </div>

    <p class="mt-4 text-sm text-gray-400 dark:text-gray-500">{LAST_UPDATED}</p>
    <section class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Frequently asked questions</h2>
      <div class="divide-y divide-gray-200 dark:divide-gray-700 rounded-lg border border-gray-200 dark:border-gray-700">
        {faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer font-medium text-gray-900 dark:text-white">{faq.question}</summary>
            <p class="mt-2 leading-relaxed text-gray-600 dark:text-gray-300">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>
