---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BaseHead from '../components/seo/BaseHead.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import '../styles/global.css';
import { buildCanonical, SITE_NAME, SITE_URL, OG_IMAGE, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT, breadcrumbSchema, articleSchema, faqSchema, organizationSchema, personSchema, LAST_UPDATED } from '../lib/seo';
import { TAX_YEAR } from '../data/tax-rules-2026-27';

const title = `UK Tax News ${TAX_YEAR}: Rate Changes, Thresholds & Updates`;
const description = `Every UK tax and salary change that reaches a payslip in ${TAX_YEAR}: income tax bands, NI rates, student loan thresholds, pension limits and the key dates.`;
const canonical = buildCanonical('/news/');

const breadcrumbItems = [
  { name: 'Home', url: SITE_URL },
  { name: 'News', url: canonical },
];

const faqs = [
  { question: "What changed for the 2026/27 tax year?", answer: "The personal allowance and the higher-rate threshold remain frozen, which raises the effective burden as wages rise, employer National Insurance stays at the rate and threshold set in April 2025, and the Scottish bands continue to diverge further from the rest of the UK." },
  { question: "Why do frozen thresholds increase my tax?", answer: "Because wages rise while the thresholds do not, so a pay rise that only matches inflation can still push part of your income into a higher band. The effect is often called fiscal drag, and it raises revenue without any rate changing." },
  { question: "When are new rates announced?", answer: "Usually at the autumn Budget, with the figures taking effect from 6 April. Scotland sets its own income tax rates in a separate Budget, generally in December, which is why the Scottish figures sometimes arrive after the UK-wide ones. Payroll software is updated in March, ready for the new year." },
  { question: "Do these changes affect my payslip automatically?", answer: "The rates do, through payroll. Your tax code does not always follow: a change of benefit, a new job or an underpayment from an earlier year all need HMRC to issue a new code, and the first payslip of the tax year is the one to check." },
  { question: "Where can I verify these figures?", answer: "In the HMRC rates and thresholds guidance for employers and, for Scotland, the Scottish Government's income tax policy page. Every figure quoted here is checked against those sources, and the date of the last check appears at the top of the page." },
  { question: "How often is this page updated?", answer: "Whenever a rate, threshold or allowance changes, and at the start of each tax year when the new figures take effect. Nothing is rewritten simply to refresh a date: the date shown is the date of the last genuine check." },
];

const schemas = [
  faqSchema(faqs),
  breadcrumbSchema(breadcrumbItems),
  articleSchema({ headline: title, description, url: canonical }),
  organizationSchema(),
  personSchema(),
];

interface NewsItem {
  date: string;
  title: string;
  content: string;
  links?: { href: string; label: string }[];
}

const items: NewsItem[] = [
  {
    date: '12 May 2026',
    title: 'All calculators updated for 2026/27 tax year',
    content: 'Every calculator on Real Salary has been updated with the confirmed 2026/27 rates and thresholds from HMRC, including income tax bands, National Insurance rates, student loan thresholds and pension auto-enrolment limits.',
    links: [{ href: '/', label: 'Salary Calculator' }],
  },
  {
    date: '6 April 2026',
    title: 'Income tax: Personal Allowance and bands remain frozen',
    content: 'The Personal Allowance stays at £12,570 and the higher rate threshold at £50,270 for 2026/27. With wage growth, more earners are being pulled into higher tax bands through fiscal drag. The additional rate of 45% continues to apply from £125,140.',
    links: [
      { href: '/income-tax/', label: 'Income Tax Calculator' },
      { href: '/guides/income-tax-bands-explained/', label: 'Income Tax Bands Guide' },
    ],
  },
  {
    date: '6 April 2026',
    title: 'National Insurance: Employee rate unchanged at 8%',
    content: 'The employee Class 1 NI rate remains at 8% on earnings between £12,570 and £50,270, with 2% above. However, employer NI has risen to 15% (from 13.8%), and the Secondary Threshold has dropped to £5,000, increasing the cost of employment.',
    links: [
      { href: '/national-insurance/', label: 'NI Calculator' },
      { href: '/guides/national-insurance-explained/', label: 'NI Explained Guide' },
    ],
  },
  {
    date: '6 April 2026',
    title: 'Student loan repayment thresholds 2026/27',
    content: 'Updated thresholds: Plan 1 rises to £24,990, Plan 2 to £27,295, Plan 4 to £31,395, and Plan 5 to £25,000. Postgraduate loan repayment threshold remains £21,000. All at 9% (postgrad: 6%) of earnings above the threshold.',
    links: [
      { href: '/student-loan/', label: 'Student Loan Calculator' },
      { href: '/guides/student-loan-repayment-guide/', label: 'Student Loan Guide' },
    ],
  },
  {
    date: '6 April 2026',
    title: 'National Living Wage rises to £12.21',
    content: 'The National Living Wage for workers aged 21 and over increases to £12.21 per hour from April 2026, up from £11.44. The 18-20 rate rises to £10.00 and the apprentice rate to £7.55.',
    links: [{ href: '/hourly-rate/', label: 'Hourly Rate Calculator' }],
  },
  {
    date: '6 April 2026',
    title: 'Pension auto-enrolment: minimum contributions unchanged',
    content: 'Minimum auto-enrolment contributions remain at 8% of qualifying earnings (5% employee, 3% employer) for 2026/27. The qualifying earnings band is £6,240 to £50,270. Salary sacrifice remains the most tax-efficient method.',
    links: [
      { href: '/pension-contribution/', label: 'Pension Calculator' },
      { href: '/guides/pension-salary-sacrifice-explained/', label: 'Pension Guide' },
    ],
  },
  {
    date: '6 April 2026',
    title: 'Scottish income tax: Six bands continue',
    content: 'Scotland retains its six-band income tax structure for 2026/27: starter (19%), basic (20%), intermediate (21%), higher (42%), advanced (45%), and top (48%). The starter band begins at £12,571 and the top rate applies from £125,141.',
    links: [{ href: '/', label: 'Salary Calculator (Scotland option)' }],
  },
  {
    date: '6 April 2026',
    title: 'Marriage Allowance remains £252 per year',
    content: 'The Marriage Allowance transfer stays at £1,260 (10% of the Personal Allowance), saving up to £252 per year. Available where one partner earns under £12,570 and the other is a basic rate taxpayer.',
  },
];
const resumeCitable = "This page tracks the UK tax and salary changes that actually reach a payslip. For 2026/27 the personal allowance and the higher-rate threshold remain frozen, which raises the effective burden as wages rise without any rate changing, an effect usually called fiscal drag. Employer National Insurance stays at the rate and threshold introduced in April 2025, and the Scottish bands continue to diverge from the rest of the UK. Rates are generally announced at the autumn Budget and take effect on 6 April, with Scotland setting its own income tax in a separate Budget in December. Every figure here is checked against the HMRC guidance for employers, and the date of the last check appears at the top of the page. A change in the published rates does not always reach your payslip on its own: a new tax code has to be issued for benefits or corrections.";

const corpsRedige = [{"titre": "What frozen thresholds actually cost you", "paragraphes": ["Freezing a threshold is a tax rise that never has to be announced. When the personal allowance and the higher-rate threshold stay at £12,570 and £50,270 while wages rise, more of each salary falls into the taxed bands and some salaries cross into the higher rate for the first time. The effect compounds: a worker whose pay rises with inflation for several years ends up paying a higher effective rate on the same real income.", "The scale is easy to underestimate. On a £45,000 salary rising three per cent a year, the extra tax from a frozen higher-rate threshold reaches several hundred pounds within a few years, and the worker crosses into the 40 per cent band without ever having received a real pay rise. That is why the freeze has raised more revenue than most of the rate changes announced alongside it."]}, {"titre": "The dates that matter in a tax year", "paragraphes": ["The tax year runs from 6 April to 5 April. Rates announced at the autumn Budget take effect on that April date, and payroll software is updated in March ready for it. Scotland sets its own income tax in a separate Budget, generally in December, which is why the Scottish figures sometimes arrive after the UK-wide ones and occasionally change late.", "For anyone filing a return, 31 October is the deadline for a paper self-assessment and 31 January for an online one, with the balancing payment due on the same day and the second payment on account on 31 July. Missing the January date brings an automatic penalty regardless of whether tax is owed, which is the most common avoidable cost in the whole calendar.", "Two other dates are worth noting. P60s must reach employees by 31 May, and P11Ds covering benefits in kind by 6 July. Both are the documents that let you check a year's tax rather than assume it, and both are worth keeping for at least three years in case HMRC opens an enquiry."]}, {"titre": "Changes worth watching over the next year", "paragraphes": ["Three things move the figures on this site. The first is the Budget, where rates and thresholds are set, usually in the autumn for the following April. The second is the Scottish Budget, which sets Scottish income tax separately and has widened the gap with the rest of the UK in each of the last several years. The third is the annual uprating of the student loan thresholds, which is announced quietly and changes the repayment for millions of people.", "Two slower changes matter as much. The National Insurance rate and threshold for employers, altered sharply in April 2025, continue to shape hiring costs and therefore pay offers. And the repeated freezing of the personal allowance and the higher-rate threshold continues to move workers into higher bands without any headline rate changing, which is the largest single tax change of the decade by revenue."]}, {"titre": "How we verify what appears on this page", "paragraphes": ["Every rate quoted here is checked against the HMRC rates and thresholds guidance for employers, or against the Scottish Government's published income tax policy for the Scottish bands. Where a figure comes from a Budget announcement that has not yet reached the guidance, the page says so rather than presenting it as settled.", "Pages carry the date of their last genuine check, not the date they were served. A threshold that has been frozen is still checked each year: the figure is verified even when it has not moved, and that is what the date records. When a rate changes mid-year, the affected calculators are updated first and the news page follows."]}, {"titre": "Scotland: a widening divergence", "paragraphes": ["Scotland has added bands rather than simply changing rates, which is why the comparison with the rest of the UK is no longer a single number. The starter rate of 19 per cent applies to a narrow slice just above the personal allowance, the intermediate rate sits between basic and higher, and the advanced and top rates apply well above the point where the rest of the UK reaches 45 per cent.", "The practical effect is that a Scottish taxpayer on a modest salary pays marginally less than an English one, while a higher earner pays noticeably more, and the crossover has drifted upwards over recent years as thresholds moved. Anyone comparing job offers across the border should compare take-home pay for the specific salary rather than assuming the direction of the difference."]}, {"titre": "Where these figures come from", "paragraphes": ["Rates, thresholds and allowances come from the HMRC rates and thresholds guidance for employers and from the Scottish Government's income tax policy. Student loan thresholds come from the Student Loans Company's annual announcement, and pension figures from the auto-enrolment thresholds published each year. Each of those is a primary source rather than a press summary, which is why the figures here occasionally differ from early reporting of a Budget."]}, {"titre": "What to do when a rate changes", "paragraphes": ["Most changes reach a payslip automatically through payroll software, updated each March for the April start. What does not update automatically is your tax code: a new benefit in kind, a corrected underpayment or a change in circumstances all require HMRC to issue a new code, and until it does the old one keeps being applied.", "The practical routine is short. In April, check that the personal allowance in your code matches the published figure. After any change of job, benefit or pay, check the code again a month later. And if a code looks wrong, correct it through your personal tax account rather than waiting for the year-end reconciliation, which can leave the error running for months."]}, {"titre": "Why this page exists", "paragraphes": ["Tax changes are reported when they are announced and forgotten when they take effect, which is six months later and on a different set of numbers. This page tracks what actually applies in the current year, with the figure, the date it started and the source it comes from, so that a payslip can be checked against something firmer than a memory of a Budget headline.", "It covers only what reaches an ordinary payslip or self-assessment return: income tax, National Insurance, student loans, pensions and the thresholds around them. Corporation tax, VAT and the rest sit outside it, not because they do not matter but because they do not explain why a salary produced less than expected this month. Where a change affects both, such as the employer National Insurance rise of April 2025, it is covered here for the effect it has on pay offers rather than on company accounts."]}];

---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Radif Partners" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
  <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
  <meta property="og:image:alt" content="UK Tax News and Updates - rate changes and thresholds" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={OG_IMAGE} />
  <BaseHead slug="/news/" pageType="news" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="manifest" href="/manifest.webmanifest" />
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
  <a href="#main-content" class="skip-link bg-navy-600 text-white">Skip to content</a>
  <Header />

  <main id="main-content" class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs items={breadcrumbItems} />
    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">Tax News & Updates</h1>
      <p class="mt-3 text-lg text-gray-500 dark:text-gray-400">
        All important UK tax and salary changes for the {TAX_YEAR} tax year, with links to affected calculators.
      </p>
    </header>
    <p class="mt-6 rounded-lg border-l-4 border-navy-600 bg-gray-50 p-4 text-base leading-relaxed text-gray-800 dark:border-navy-400 dark:bg-gray-800/40 dark:text-gray-200">
      {resumeCitable}
    </p>

    <div class="space-y-8">
      {items.map((item) => (
        <article class="rounded-lg border border-gray-200 p-5 dark:border-gray-700">
          <time class="text-sm font-medium text-navy-600 dark:text-navy-400">{item.date}</time>
          <h2 class="mt-1 text-lg font-bold text-gray-900 dark:text-white">{item.title}</h2>
          <p class="mt-2 text-gray-600 dark:text-gray-300">{item.content}</p>
          {item.links && item.links.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-3">
              {item.links.map((l) => (
                <a href={l.href} class="inline-flex items-center gap-1 text-sm font-medium text-navy-600 hover:text-navy-700 dark:text-navy-400 dark:hover:text-navy-300">
                  {l.label} &rarr;
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>

    <p class="mt-8 text-sm text-gray-400 dark:text-gray-500">{LAST_UPDATED}</p>
    <section class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Frequently asked questions</h2>
      <div class="divide-y divide-gray-200 dark:divide-gray-700 rounded-lg border border-gray-200 dark:border-gray-700">
        {faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer font-medium text-gray-900 dark:text-white">{faq.question}</summary>
            <p class="mt-2 leading-relaxed text-gray-600 dark:text-gray-300">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>


    <section class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Sources</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
        Every rate and threshold used on this site comes from the following official publications:
      </p>
      <ul class="space-y-1 text-sm">
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/guidance/rates-and-thresholds-for-employers-2026-to-2027" rel="noopener">HMRC, rates and thresholds for employers 2026/27</a></li>
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/income-tax-rates" rel="noopener">GOV.UK, income tax rates and personal allowances</a></li>
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/national-insurance-rates-letters" rel="noopener">GOV.UK, National Insurance rates and categories</a></li>
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/repaying-your-student-loan/what-you-pay" rel="noopener">GOV.UK, student loan repayment thresholds</a></li>
      </ul>
    </section>

    <section class="mt-12 space-y-8">
      {corpsRedige.map((bloc) => (
        <div>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">{bloc.titre}</h2>
          {bloc.paragraphes.map((p) => (
            <p class="mb-4 leading-relaxed text-gray-700 dark:text-gray-300">{p}</p>
          ))}
        </div>
      ))}
    </section>

  </main>

  <Footer />
</body>
</html>
