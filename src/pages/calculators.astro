---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BaseHead from '../components/seo/BaseHead.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import '../styles/global.css';
import { buildCanonical, SITE_NAME, SITE_URL, OG_IMAGE, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT, breadcrumbSchema, faqSchema, organizationSchema, personSchema, LAST_UPDATED } from '../lib/seo';

const title = 'All UK Salary & Tax Calculators 2026/27 | Free Online Tools';
const description = 'Free UK salary, tax, NI, pension, student loan and bonus calculators for the 2026/27 tax year. HMRC-verified rates, instant results, no sign-up required.';
const canonical = buildCanonical('/calculators/');

const breadcrumbItems = [
  { name: 'Home', url: SITE_URL },
  { name: 'All Calculators', url: canonical },
];

const faqs = [
  { question: "Which calculator should I use?", answer: "Start with the take-home pay calculator if you know your annual salary and want the monthly figure. Use the reverse calculator if you know the net pay you need and want the gross to ask for. The others answer narrower questions: bonuses, two jobs, pensions, student loans and employer cost." },
  { question: "Are these calculators up to date for 2026/27?", answer: "Yes. The rates, thresholds and bands come from the published HMRC figures for the 2026/27 tax year, including the Scottish bands, and each page carries the date of its last check rather than the date it was served. When a threshold moves mid-year, the page is updated and the date with it." },
  { question: "Do they work for Scotland?", answer: "Yes. Income tax is devolved and Scotland has six bands instead of three, so every calculator here applies the Scottish rates when you select Scotland, and the dedicated Scottish calculator shows the difference against the rest of the UK side by side." },
  { question: "Do the calculators store what I enter?", answer: "No. The calculation runs in your browser and nothing you type is sent to a server or stored. That is also why no result is saved between visits: there is no account and nothing to sign up for. Audience measurement records the page visited, never the figures you type into a field." },
  { question: "How accurate are the results?", answer: "They are exact for the standard case: one job, the standard tax code, no benefits in kind. A non-standard code, a company car, salary sacrifice taken outside payroll or a mid-year job change will shift the figure, and only a payslip settles it." },
  { question: "Why does my payslip differ from the calculator?", answer: "Usually the tax code, a student loan plan the calculator was not told about, or a pension contribution deducted after tax rather than before. Comparing the gross, the taxable pay and the code on the payslip against the inputs here finds the difference in a minute." },
];

const schemas = [
  faqSchema(faqs),
  breadcrumbSchema(breadcrumbItems),
  organizationSchema(),
  personSchema(),
];

const calculators = [
  {
    category: 'Salary & Pay',
    items: [
      { href: '/', name: 'Salary Calculator', desc: 'Full breakdown of income tax, NI and take-home pay from your annual salary' },
      { href: '/take-home-pay/', name: 'Take-Home Pay Calculator', desc: 'See exactly what lands in your bank account each month' },
      { href: '/hourly-rate/', name: 'Hourly Rate Calculator', desc: 'Convert annual or monthly salary to an hourly rate, gross and net' },
      { href: '/pro-rata/', name: 'Pro-Rata Salary Calculator', desc: 'Calculate part-time salary based on full-time equivalent and hours' },
      { href: '/required-salary/', name: 'Required Salary Calculator', desc: 'Find the gross salary needed to achieve a target take-home amount' },
    ],
  },
  {
    category: 'Tax & Deductions',
    items: [
      { href: '/income-tax/', name: 'Income Tax Calculator', desc: 'Calculate income tax across all bands for England, Wales, NI and Scotland' },
      { href: '/national-insurance/', name: 'National Insurance Calculator', desc: 'Employee and employer NI contributions with Class 1 breakdown' },
      { href: '/student-loan/', name: 'Student Loan Calculator', desc: 'Repayment amounts for Plan 1, 2, 4, 5 and postgraduate loans' },
      { href: '/bonus/', name: 'Bonus Tax Calculator', desc: 'See how much tax you pay on a one-off bonus payment' },
      { href: '/two-jobs/', name: 'Two Jobs Tax Calculator', desc: 'Calculate combined tax and NI when holding two employment positions' },
    ],
  },
  {
    category: 'Pension & Retirement',
    items: [
      { href: '/pension-contribution/', name: 'Pension Contribution Calculator', desc: 'Compare salary sacrifice vs relief at source pension contributions' },
    ],
  },
];
const resumeCitable = "These calculators apply the 2026/27 income tax bands, National Insurance thresholds and student loan plans to whatever figures you enter, and they agree with each other because they share one calculation engine. The take-home calculator answers the common question, the reverse calculator works backwards from the net pay you need to the gross to ask for, and the rest deal with narrower cases: bonuses withheld at an unrepresentative rate, two jobs taxed separately, pension contributions, employer cost, Scottish bands. Everything runs in your browser, so nothing you type is sent anywhere or stored. The figures are exact for the standard case and indicative for yours: a non-standard tax code or a benefit in kind will move the result. Comparing the taxable pay line on your payslip with the gross you entered here finds the difference in about a minute.";

const corpsRedige = [{"titre": "How the calculators work, and what they assume", "paragraphes": ["Every calculator on this page runs the same engine: the 2026/27 income tax bands for England, Wales and Northern Ireland or the six Scottish bands, the National Insurance thresholds, the student loan plans and the auto-enrolment pension rules. The order of operations matters and is the same everywhere: salary sacrifice contributions come off first, then income tax on what remains above the personal allowance, then National Insurance, then any student loan repayment.", "The default assumptions are the standard ones: a single job, the 1257L tax code, no benefits in kind, no salary sacrifice unless you enter it. Those are the conditions most employees are in, and they are also the conditions under which a calculation matches a payslip exactly. Change any of them and the figure moves, which is why each calculator asks for the inputs it needs rather than guessing.", "Nothing you type leaves your browser. There is no account, no saved history and no server-side calculation, which is also why a result disappears when you close the tab. Audience measurement records which page was visited and nothing about the figures entered into it."]}, {"titre": "Choosing the right tool for the question", "paragraphes": ["For a straightforward salary, the take-home calculator gives the monthly and annual figures with the deductions broken out. For a part-time role, the pro-rata calculator scales the full-time equivalent and applies tax to the lower figure, which is where the personal allowance makes part-time work proportionally cheaper to tax.", "For a bonus, use the dedicated tool rather than adding the amount to the annual salary: PAYE treats a bonus month as though it were typical, so the deduction on the payslip is usually larger than the eventual liability, and the bonus calculator shows both. For two jobs, the two-jobs calculator applies the thresholds to each employment separately, which a single-salary calculation cannot do.", "For anyone hiring, the employer cost calculator adds National Insurance at 15 per cent above £5,000, the minimum pension contribution and the Employment Allowance where it applies, which together put the true cost of a hire fifteen to twenty per cent above the salary. And for a budget set in net pounds, the required salary calculator works backwards from the take-home you need to the gross to ask for."]}, {"titre": "The three inputs that change a result most", "paragraphes": ["The tax code is the first. 1257L is the standard code for someone with one job and no benefits in kind; a BR code taxes everything at the basic rate from the first pound, a D0 code at the higher rate, and an emergency code applies the allowance on a non-cumulative basis. A wrong code is the single commonest cause of a payslip that does not match a calculation, and it is corrected by HMRC rather than by the employer.", "The pension contribution is the second, and the mechanism matters as much as the amount. Salary sacrifice reduces gross pay, so it cuts income tax and National Insurance together; a net pay arrangement cuts income tax only; relief at source requires a higher-rate taxpayer to claim the extra relief separately, which many never do. The same five per cent produces three different take-home figures.", "The student loan plan is the third. Plans 1, 2, 4 and 5 have thresholds differing by thousands of pounds, and a postgraduate loan is repaid alongside an undergraduate one at a further six per cent. Selecting the wrong plan, or forgetting one entirely, can shift the monthly result by more than a hundred pounds."]}, {"titre": "Reading a payslip against a calculation", "paragraphes": ["Four lines settle almost every discrepancy. The gross for the period should match the salary divided by the number of pay periods, plus any bonus or overtime. The taxable pay should be the gross minus pre-tax deductions, which is the figure the tax is actually charged on. The tax code should be the one HMRC has issued, visible in your personal tax account. And the year-to-date columns should rise consistently from month to month.", "Where the calculation and the payslip still differ, the usual culprits in order are a benefit in kind reducing the allowance through the code, a student loan plan not accounted for, a pension deducted after tax rather than before, and a mid-year change of job carrying over figures from a P45. Each of those is visible on the payslip once you know to look for it."]}, {"titre": "Scotland, and why one line of the payslip differs", "paragraphes": ["Income tax on earnings is devolved to Scotland, which applies six bands from 19 to 48 per cent instead of the three used in the rest of the UK. Below roughly £28,000 a Scottish taxpayer pays slightly less; above that they pay more, and the difference grows with income until it exceeds three thousand pounds a year at the top. Residence decides which schedule applies, not the employer's address, and HMRC marks it with an S prefix on the tax code.", "Everything else stays the same. National Insurance, dividend tax, savings interest tax and capital gains tax are reserved and identical across the four nations, which is why only one line of a Scottish payslip differs from an English one. Pension relief follows the Scottish rates, so an intermediate-rate taxpayer is entitled to 21 per cent rather than 20, and the extra point has to be claimed from HMRC rather than arriving automatically through the provider."]}, {"titre": "What these calculators deliberately do not do", "paragraphes": ["They do not model benefits in kind, because the tax on a company car or private medical cover arrives through the tax code rather than through the payslip arithmetic, and the amounts depend on details only the P11D holds. They do not model the high income child benefit charge, which is settled through self-assessment rather than PAYE. And they do not model mid-year job changes, where a P45 carries year-to-date figures into the new employment and changes the cumulative calculation.", "In each of those cases the right tool is your personal tax account on GOV.UK, which holds the actual figures HMRC is working from. The calculators here are for the question they answer well: what a given salary produces in a normal month, and how a change to pay, hours, pension or location moves it."]}, {"titre": "Keeping a payslip honest over a year", "paragraphes": ["Check the first payslip of a new job, the first after any pay rise, and the first of each tax year in April. Those three moments cover almost every error that PAYE produces, and catching one in month one costs a phone call while catching it in month eleven costs a reconciliation. The figures to compare are the tax code, the taxable pay and the year-to-date columns.", "Keep the P60 each May and the P11D each July. Between them they prove a year's income and benefits, which matters for a mortgage application, a tax return and any dispute with HMRC. Three years is the usual retention period for an ordinary return, six where income may have been understated, and there is no limit where a return was never filed at all."]}, {"titre": "A note on accuracy and on limits", "paragraphes": ["These tools apply published rules to the figures you enter, which makes them exact for the case they model and indicative for a real payslip. The gap between the two comes from details a calculator cannot know: a code adjusted for an earlier underpayment, a benefit in kind, a mid-year change of employer, a salary sacrifice arrangement run outside payroll. None of those is exotic, and each moves the result.", "They are also not advice. They will tell you what the rules produce; they will not tell you whether to take a job, sacrifice a bonus or move to Scotland. For a decision with money or a deadline attached, an accountant or the relevant HMRC helpline is the right next step, and arriving at that conversation with the figures already worked out is what makes it short."]}];

---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Radif Partners" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
  <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
  <meta property="og:image:alt" content="All UK Salary and Tax Calculators - free online tools" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={OG_IMAGE} />
  <BaseHead slug="/calculators/" pageType="hub" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="manifest" href="/manifest.webmanifest" />
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
  <a href="#main-content" class="skip-link bg-navy-600 text-white">Skip to content</a>
  <Header />

  <main id="main-content" class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs items={breadcrumbItems} />
    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">All Calculators</h1>
      <p class="mt-3 text-lg text-gray-500 dark:text-gray-400">
        Free UK salary and tax calculators for the 2026/27 tax year. HMRC-verified rates, instant results, no sign-up required.
      </p>
    </header>
    <p class="mt-6 rounded-lg border-l-4 border-navy-600 bg-gray-50 p-4 text-base leading-relaxed text-gray-800 dark:border-navy-400 dark:bg-gray-800/40 dark:text-gray-200">
      {resumeCitable}
    </p>

    <div class="space-y-10">
      {calculators.map((cat) => (
        <section>
          <h2 class="mb-5 text-xl font-bold text-gray-900 dark:text-white">{cat.category}</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {cat.items.map((calc) => (
              <a href={calc.href} class="group rounded-lg border border-gray-200 p-4 transition-colors hover:border-navy-300 hover:bg-navy-50 dark:border-gray-700 dark:hover:border-navy-600 dark:hover:bg-gray-800">
                <h3 class="font-semibold text-gray-900 group-hover:text-navy-700 dark:text-white dark:group-hover:text-navy-300">{calc.name}</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{calc.desc}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="mt-8 text-sm text-gray-400 dark:text-gray-500">{LAST_UPDATED}</p>
    <section class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Frequently asked questions</h2>
      <div class="divide-y divide-gray-200 dark:divide-gray-700 rounded-lg border border-gray-200 dark:border-gray-700">
        {faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer font-medium text-gray-900 dark:text-white">{faq.question}</summary>
            <p class="mt-2 leading-relaxed text-gray-600 dark:text-gray-300">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>


    <section class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Sources</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
        Every rate and threshold used on this site comes from the following official publications:
      </p>
      <ul class="space-y-1 text-sm">
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/guidance/rates-and-thresholds-for-employers-2026-to-2027" rel="noopener">HMRC, rates and thresholds for employers 2026/27</a></li>
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/income-tax-rates" rel="noopener">GOV.UK, income tax rates and personal allowances</a></li>
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/national-insurance-rates-letters" rel="noopener">GOV.UK, National Insurance rates and categories</a></li>
        <li><a class="text-navy-600 underline hover:no-underline dark:text-navy-400" href="https://www.gov.uk/repaying-your-student-loan/what-you-pay" rel="noopener">GOV.UK, student loan repayment thresholds</a></li>
      </ul>
    </section>

    <section class="mt-12 space-y-8">
      {corpsRedige.map((bloc) => (
        <div>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">{bloc.titre}</h2>
          {bloc.paragraphes.map((p) => (
            <p class="mb-4 leading-relaxed text-gray-700 dark:text-gray-300">{p}</p>
          ))}
        </div>
      ))}
    </section>

  </main>

  <Footer />
</body>
</html>
