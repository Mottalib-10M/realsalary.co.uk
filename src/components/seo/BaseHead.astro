---
/**
 * Shared <head> snippet: Microsoft Clarity (cookieless) and Bing Webmaster verification.
 */
import { CLARITY_PROJECT_ID, BING_VERIFY_CODE } from '../../lib/seo';

interface Props {
  slug: string;
  pageType?: string;
}
---

{BING_VERIFY_CODE && <meta name="msvalidate.01" content={BING_VERIFY_CODE} />}

{/* Mesure technique et anonyme de la stabilité (RECETTE §15.6, 2026-10-06) : aucun cookie.
     consentv2 « denied » mis en file AVANT le script Clarity : mode sans cookie (ni _clck, _clsk,
     MUID, CLID), un identifiant par page vue ; contenu masqué par data-clarity-mask sur <body>. */}
{CLARITY_PROJECT_ID && (
  <script is:inline set:html={`(function(){window.clarity=window.clarity||function(){(window.clarity.q=window.clarity.q||[]).push(arguments);};window.clarity('consentv2',{ad_Storage:'denied',analytics_Storage:'denied'});var s=document.createElement('script');s.async=true;s.src='https://www.clarity.ms/tag/${CLARITY_PROJECT_ID}';document.head.appendChild(s);})();`} />
)}
